	(title_block
		(title "ProComm AUDIO-8X8 - Local Power, Sequencing, and Ground Star")
		(date "2026-08-16")
		(rev "A1")
		(company "ProComm")
		(comment 1 "AUDIO_12V is the only carrier power input; local 3 A fuse and one GND-to-AGND star")
		(comment 2 "TRI 20-1223 creates +/-15 V; TPS62913 creates the quiet 5.5 V pre-rail")
		(comment 3 "Separate LT3045 5 V/300 mA rails feed ADC and DAC; TPS7A2033 feeds AKM digital I/O")
		(comment 4 "Power-good, sequencing, thermal rise, ripple, and conducted-emissions tests gate release")
	)
