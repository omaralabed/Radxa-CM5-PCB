	(title_block
		(title "Radxa CM5 ProComm Carrier - Thermal and GPIO Control")
		(date "2026-08-14")
		(rev "A1")
		(company "ProComm")
		(comment 1 "EMC2305 controls CPU, modem, intake, and exhaust fans independently")
		(comment 2 "PWM pull-ups provide full-speed hardware fallback if the controller or firmware fails")
		(comment 3 "TMP117 sensors monitor CM5, modem, and board/power zones at 0x48/0x49/0x4A")
		(comment 4 "TCA9535 devices at 0x20/0x21/0x22 capture status and drive safe control outputs")
		(comment 5 "Two 12 V diffused warm-white panel lamps use an independent latching capacitive touch switch")
	)
