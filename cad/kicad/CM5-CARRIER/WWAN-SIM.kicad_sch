	(text "1. UNIVERSAL M.2 B-KEY WWAN SOCKET"
		(exclude_from_sim no)
		(at 45 20 0.0000)
		(effects
			(font
				(size 1.9 1.9)
				(bold yes)
			)
		)
		(uuid "6a58026b-fd1a-5447-8f41-c602291f8001")
	)
	(text "Socket power pins retain the stock symbol's 3.3 V names but are intentionally fed from MODEM_3V8."
		(exclude_from_sim no)
		(at 45 260 0.0000)
		(effects
			(font
				(size 0.82 0.82)
			)
		)
		(uuid "8450fd31-d3d8-5a4d-9086-d5e06de2eb85")
	)
	(text "Qualification window: 3.135-4.4 V module input, >=5 A transient capability, keyed B socket, 42 mm standoff."
		(exclude_from_sim no)
		(at 45 270 0.0000)
		(effects
			(font
				(size 0.82 0.82)
			)
		)
		(uuid "0e242e99-1994-5a3b-a125-7c441fd35dd1")
	)
	(text "2. USB ESD AND MODEM BULK CAPACITANCE"
		(exclude_from_sim no)
		(at 300 20 0.0000)
		(effects
			(font
				(size 1.75 1.75)
				(bold yes)
			)
		)
		(uuid "5ebd1d1c-98a3-5bcb-aa58-8b35848644ee")
	)
	(text "Place USB ESD at the modem socket; route USB 3 pairs as short, continuous 90 ohm differential channels."
		(exclude_from_sim no)
		(at 300 190 0.0000)
		(effects
			(font
				(size 0.8 0.8)
			)
		)
		(uuid "fd9b2295-2f53-525e-b080-ae850643cffb")
	)
	(text "C701-C712 and D701 implement the RM520N-GL two-bank VCC reference network directly at M.2 pins 2/4 and 70/72/74."
		(exclude_from_sim no)
		(at 300 290 0.0000)
		(effects
			(font
				(size 0.72 0.72)
			)
		)
		(uuid "e339e971-3046-5069-b91e-36b39afaee57")
	)
	(text "Power-Regulators C1189-C1192 retain 1320 uF upstream bulk; they do not replace the socket-local 2 x 220 uF and HF ladder."
		(exclude_from_sim no)
		(at 300 300 0.0000)
		(effects
			(font
				(size 0.72 0.72)
			)
		)
		(uuid "c9298e7a-5b64-5a4e-9533-7674273b0244")
	)
	(text "3. FSA2567 DUAL-SIM MUX"
		(exclude_from_sim no)
		(at 470 20 0.0000)
		(effects
			(font
				(size 1.75 1.75)
				(bold yes)
			)
		)
		(uuid "ec3467bb-2470-5cf2-aa45-360548591b8b")
	)
	(text "R701 keeps SEL high: SIM 1 is selected by default. GPIO control must be open drain; low selects SIM 2."
		(exclude_from_sim no)
		(at 470 210 0.0000)
		(effects
			(font
				(size 0.82 0.82)
			)
		)
		(uuid "e3cd1fae-a4fe-53b5-9635-1624bc7d72c7")
	)
	(text "Physical SIM 1 uses FSA2567 channel 2 and physical SIM 2 uses channel 1 to implement that default."
		(exclude_from_sim no)
		(at 470 230 0.0000)
		(effects
			(font
				(size 0.76 0.76)
			)
		)
		(uuid "bb12b805-faf1-516a-b3e6-eeccfaf78397")
	)
	(text "The control domain tracks MODEM_UIM_PWR, preventing a fixed 3.3 V overdrive when the SIM rail is 1.8 V."
		(exclude_from_sim no)
		(at 470 220 0.0000)
		(effects
			(font
				(size 0.82 0.82)
			)
		)
		(uuid "3f25e054-84a0-515a-9554-055e7d5234ec")
	)
	(text "4. DIRECT DUAL-SIM DAUGHTERBOARD SOCKET"
		(exclude_from_sim no)
		(at 610 20 0.0000)
		(effects
			(font
				(size 1.65 1.65)
				(bold yes)
			)
		)
		(uuid "0943e553-87b5-5aff-835d-513eec7a4a0d")
	)
	(text "J702 plugs directly into SIM-SERVICE J1. There is no SIM cable harness; the horizontal daughterboard is fixed by four precision supports."
		(exclude_from_sim no)
		(at 610 245 0.0000)
		(effects
			(font
				(size 0.75 0.75)
			)
		)
		(uuid "8da5401f-9d44-540e-a4ac-7009594e0417")
	)
	(text "The 2.5 mm DF40 stack carries signals only. Four interleaved returns plus six auxiliary ground/chassis pins control loop area and shield impedance."
		(exclude_from_sim no)
		(at 610 258 0.0000)
		(effects
			(font
				(size 0.75 0.75)
			)
		)
		(uuid "ba857e2f-f1ee-50a6-ad18-201ce67d85bf")
	)
	(text "5. RF BULKHEAD HARNESS CONTRACT"
		(exclude_from_sim no)
		(at 525 315 0.0000)
		(effects
			(font
				(size 1.65 1.65)
				(bold yes)
			)
		)
		(uuid "c4171631-9ac0-547e-879e-42b1a99b2627")
	)
