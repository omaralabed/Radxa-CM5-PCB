	)
	(text "Control outputs originate at the system GPIO expander. FULL_CARD_POWER_OFF and RESET require final modem-specific timing validation."
		(exclude_from_sim no)
		(at 45 445 0.0000)
		(effects
			(font
				(size 0.82 0.82)
			)
		)
		(uuid "c20b236c-760e-5bad-aa15-31a2097c9a45")
	)
	(text "TP7201-TP7208 are copper factory probes. USB 2/3 has no branch or generic test header."
