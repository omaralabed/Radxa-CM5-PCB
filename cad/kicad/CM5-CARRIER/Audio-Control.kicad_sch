	(text "1. I2S0/TDM PROGRAM-AUDIO LVDS LINK"
		(exclude_from_sim no)
		(at 45 20 0.0000)
		(effects
			(font
				(size 1.9 1.9)
				(bold yes)
			)
		)
		(uuid "a22550a5-9a15-507e-b464-dfa183ba1679")
	)
	(text "J901 mates with AUDIO-8X8 J101. Route five 100 ohm differential pairs with the assigned interleaved returns."
		(exclude_from_sim no)
		(at 380 260 0.0000)
		(effects
			(font
				(size 0.82 0.82)
			)
		)
		(uuid "9e8f85f3-065e-547c-98da-2558e358d4fd")
	)
	(text "SN65LVDT2D includes the ADC-data receiver termination; do not add a duplicate far-end resistor."
		(exclude_from_sim no)
		(at 380 270 0.0000)
		(effects
			(font
				(size 0.82 0.82)
			)
		)
		(uuid "6832e963-689b-5aae-bfdb-691e9811c0b3")
	)
	(text "2. I2S1 HEADSET LEVEL TRANSLATION"
		(exclude_from_sim no)
		(at 45 340 0.0000)
