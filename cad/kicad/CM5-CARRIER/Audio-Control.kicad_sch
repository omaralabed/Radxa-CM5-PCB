		(uuid "9f4700c2-aaf5-5d53-8499-eefe8b7941f6")
	)
	(text "CM5 audio GPIO is 3.3 V. ES8316 digital pins remain entirely in the translated 1.8 V domain."
		(exclude_from_sim no)
		(at 45 615 0.0000)
		(effects
			(font
				(size 0.8 0.8)
			)
		)
		(uuid "b6a55a17-65bc-50f8-83e9-ce7ab18b845c")
	)
	(text "3. DEDICATED LOW-NOISE HEADSET RAILS"
		(exclude_from_sim no)
		(at 45 650 0.0000)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
		)
		(uuid "f2699599-209d-512b-aa57-2a60cd327ffa")
	)
	(text "R900 is the only headset analog-ground bond. Do not create a second PCB or chassis bond."
		(exclude_from_sim no)
		(at 45 805 0.0000)
		(effects
			(font
				(size 0.8 0.8)
			)
		)
		(uuid "452f17aa-049b-5080-9e1e-f6a559f46775")
	)
	(text "4. ES8316 I2S1 HEADSET CODEC"
		(exclude_from_sim no)
		(at 500 340 0.0000)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
		)
		(uuid "eb53f1df-cf38-57ce-bc61-34fbca30745e")
	)
	(text "CE is pulled to 1.8 V; all ES8316 digital pins are translated. Decoupling follows the Radxa reference topology."
		(exclude_from_sim no)
		(at 500 630 0.0000)
		(effects
			(font
				(size 0.76 0.76)
			)
		)
		(uuid "c889e31d-d187-5126-a9d4-3caa3ab6f01d")
	)
