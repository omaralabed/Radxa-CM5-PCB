	(title_block
		(title "Radxa CM5 ProComm Carrier - TDM and Headset Audio")
		(date "2026-08-14")
		(rev "A1")
		(company "ProComm")
		(comment 1 "I2S0/TDM program audio is buffered over LVDS to the separate AUDIO-8X8 board")
		(comment 2 "I2S1 drives an ES8316 headset codec based on the Radxa CM5 IO V2.2 reference")
		(comment 3 "TPA6132A2 provides the requested dedicated stereo headphone amplification")
		(comment 4 "PJ-327A is wired CTIA: tip left, ring 1 right, ring 2 ground, sleeve microphone")
	)
