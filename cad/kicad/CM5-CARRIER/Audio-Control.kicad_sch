	(text "1. I2S0/TDM PROGRAM-AUDIO LVDS LINK"
		(exclude_from_sim no)
		(at 45 20 0.0000)
		(effects
			(font
				(size 1.9 1.9)
				(bold yes)
			)
		)
		(uuid "fb2d1ead-f912-5855-89d3-aff9fa681e7c")
	)
	(text "J901 mates with AUDIO-8X8 J101. Route five 100 ohm differential pairs with the assigned interleaved returns."
		(exclude_from_sim no)
		(at 380 260 0.0000)
		(effects
			(font
				(size 0.82 0.82)
			)
		)
		(uuid "bfa388db-1558-5161-a2f5-bada188c0000")
	)
	(text "SN65LVDT2D includes the ADC-data receiver termination; do not add a duplicate far-end resistor."
		(exclude_from_sim no)
		(at 380 270 0.0000)
		(effects
			(font
				(size 0.82 0.82)
			)
		)
		(uuid "f3aae49b-400a-5e17-ac7b-92b8800cddc6")
	)
	(text "2. I2S1 HEADSET LEVEL TRANSLATION"
		(exclude_from_sim no)
		(at 45 340 0.0000)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
		)
		(uuid "0b62a680-33d4-5b75-9d58-65e6bde6d2f8")
	)
	(text "PCA9306 VREF2 and EN share HS_I2C_BIAS through the required 200 k pull-up to 3.3 V."
		(exclude_from_sim no)
		(at 45 505 0.0000)
		(effects
			(font
				(size 0.72 0.72)
			)
		)
		(uuid "50baea94-da88-5141-8b5e-7bac99ccb8f1")
	)
	(text "CM5 audio GPIO is 3.3 V. ES8316 digital pins remain entirely in the translated 1.8 V domain."
		(exclude_from_sim no)
		(at 45 615 0.0000)
		(effects
			(font
				(size 0.8 0.8)
			)
		)
		(uuid "6ccd30f6-2cae-56e3-a324-0463c8a75d98")
	)
	(text "3. DEDICATED LOW-NOISE HEADSET RAILS"
		(exclude_from_sim no)
		(at 45 650 0.0000)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
		)
		(uuid "a540526e-2393-5f57-b706-84b3d00147f8")
	)
	(text "R900 is the only headset analog-ground bond. Do not create a second PCB or chassis bond."
		(exclude_from_sim no)
		(at 45 805 0.0000)
		(effects
			(font
				(size 0.8 0.8)
			)
		)
		(uuid "3d58dbdc-0001-5c9f-8369-c3357b6c9564")
	)
	(text "4. ES8316 I2S1 HEADSET CODEC"
		(exclude_from_sim no)
		(at 500 340 0.0000)
		(effects
			(font
				(size 1.8 1.8)
				(bold yes)
			)
		)
		(uuid "58e89474-54f9-52d5-b28f-a3d6aa83445f")
	)
	(text "CE is pulled to 1.8 V; all ES8316 digital pins are translated. Decoupling follows the Radxa reference topology."
		(exclude_from_sim no)
		(at 500 630 0.0000)
		(effects
			(font
				(size 0.76 0.76)
			)
		)
		(uuid "b62b6245-0923-5442-908b-0edb761da443")
